{
  "manifest_version": 3,
  "name": "Aqrobat",
  "version": "1.0.0",
  "description": "Make experimental text and emoji QR codes from selected text, links, or pages. Runs locally.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Aqrobat · generate or insert text QR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "web/brand/rocket-16.png",
      "32": "web/brand/rocket-32.png",
      "48": "web/brand/rocket-48.png"
    }
  },
  "icons": {
    "16": "web/brand/rocket-16.png",
    "48": "web/brand/rocket-48.png",
    "128": "web/brand/rocket-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
