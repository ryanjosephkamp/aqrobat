        }
      ],
      "limit": "Source declarations and saved measurements are not a new capture or acceptance."
    },
    {
      "id": "C2",
      "kind": "measured",
      "statement": "All three saved paragraph boxes are 330 by 258px; local per-paragraph selection equals its intended string. The measured initial center is 22.5821596244px right and 46.7746478873px down from its paragraph origin.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/capture.json",
