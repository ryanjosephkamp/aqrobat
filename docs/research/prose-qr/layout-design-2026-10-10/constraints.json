          "sha256": "7709c4c943ea53a7b154f216b682e9c9fa27aeeb6cea797b08777cbce4eb769f"
        }
      ],
      "limit": "No new locator/reader call; changed placement could change branch metrics, so historical values are blockers, not predictions."
    },
    {
      "id": "C8",
      "kind": "fixed rule",
      "statement": "Native eligibility uses a nonempty matching scored-record set and every record, not one passing record; thresholds remain 0.8 and 0.35 with all four true/scored axes.",
      "sources": [
        {
          "path": "experiments/prose-qr/astra-2026-10-10/common.mjs",
