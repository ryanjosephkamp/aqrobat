    },
    {
      "id": "C12",
      "kind": "design choice",
      "statement": "L1 normalizes the nominal symbol origin to (64,64), retains dimension/pitch and inline typography, demands a completely blank four-module ring, and specifies document order 1,2,3.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/recipe.json",
          "keys": ["texts", "unit", "dimension"],
          "sha256": "be5d881f9fbb1e20c25ea2fc3c7ac1ac9115e28b51b1ed7dc556987607447b9d"
