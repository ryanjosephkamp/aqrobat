            "fonts",
            "repeatExact",
            "reasons"
          ],
          "sha256": "65aa08a03374a0f84d98a8ee07945e958ab88d6febe9f738150be6bd67e729ee"
        }
      ],
      "limit": "No full-document copy-order, clipboard round trip or portable paste evidence."
    },
    {
      "id": "C3",
      "kind": "measured",
      "statement": "Saved nominal field accounting is 226 intersecting / 188 wholly inside / 527 visible non-space body boxes, with 51 boxes touching the proposed quiet ring. The ring has 1286 of 31844 pixels below gray128.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/layout-audit-01/results.json",
          "keys": [
            "nominalSymbolRectangle",
            "nominalQuietOuterRectangle",
            "paragraphs",
            "visibleBodyGlyphs",
            "symbolSourcePixelAccounting",
            "quietRingSourcePixelAccounting"
          ],
          "sha256": "166851874064aeb8ed930f7adcf5c75ee1fbd5e8c0ebeaddacf39e8356e307ef"
        }
      ],
      "limit": "Advance boxes differ from ink masks; stored pixel counts were not recounted. Counts include all ink, not body-only attribution."
    },
    {
      "id": "C4",
      "kind": "arithmetic",
      "statement": "For intended finder centers at 3.5 modules from the symbol edge, right-edge clearance is 16.5px; the four-module quiet ring extends from offset 16.5 to 35.3571428571px from the upper-right center.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/recipe.json",
          "keys": ["unit", "dimension"],
          "sha256": "be5d881f9fbb1e20c25ea2fc3c7ac1ac9115e28b51b1ed7dc556987607447b9d"
        },
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/layout-audit-01/results.json",
          "keys": [
            "sourceGeometry",
            "nominalSymbolRectangle",
            "nominalQuietOuterRectangle"
          ],
          "sha256": "166851874064aeb8ed930f7adcf5c75ee1fbd5e8c0ebeaddacf39e8356e307ef"
        }
      ],
      "limit": "The four-module empty ring is a design requirement, not a newly proved universal decoder requirement."
    },
    {
      "id": "C5",
      "kind": "arithmetic",
      "statement": "The retained upper-right u ink interval is [24.7879575631,32.3553403756]px relative to its finder center, wholly inside the right quiet-ring x interval. The initial right ink estimate exceeds its nominal right boundary by 5.9898389718px.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/capture.json",
          "keys": [
            "dom.paragraphs[1].counter.x",
            "dom.paragraphs[1].glyphs[1].ch",
            "dom.paragraphs[1].glyphs[1].ink",
            "dom.paragraphs[1].firstGlyph.ink"
