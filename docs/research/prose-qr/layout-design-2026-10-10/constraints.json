  "constraints": [
    {
      "id": "C1",
      "kind": "measured",
      "statement": "The retained source declares dimension 85, pitch 33/7, three exact Once/Our/Often paragraphs, 18/27 ArialMT with tracking 1 and 64px Copperplate-Bold outlined initials.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/recipe.json",
          "keys": [
            "dimension",
            "unit",
