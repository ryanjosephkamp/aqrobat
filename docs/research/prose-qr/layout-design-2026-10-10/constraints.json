          "sha256": "65aa08a03374a0f84d98a8ee07945e958ab88d6febe9f738150be6bd67e729ee"
        }
      ],
      "limit": "Continuous source-metric estimate, not a rerendered pixel mask. This rejects the retained local placement, not every possible reflow or glyph."
    },
    {
      "id": "C6",
      "kind": "arithmetic",
      "statement": "At fixed pitch and local typography, N cancels from edge minus far finder center; translating or enlarging the symbol cannot cure that local margin. Intact paragraph-box right/bottom excesses are about 290.918 and 194.725px.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/context-04/continuous-article/capture.json",
          "keys": [
            "dom.paragraphs[1].rect",
