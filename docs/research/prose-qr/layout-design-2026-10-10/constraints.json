          "keys": ["unit", "dimension"],
          "sha256": "be5d881f9fbb1e20c25ea2fc3c7ac1ac9115e28b51b1ed7dc556987607447b9d"
        }
      ],
      "limit": "The invariant assumes retained inline corner initial and typography. Reflow, different glyphs and changed spacing are not shown impossible."
    },
    {
      "id": "C7",
      "kind": "measured",
      "statement": "Context-04 normal first location is unrelated dimension 81; the actual inverted branch first location has intended dimension 85 but balance 0.266667, span 0.282828 and upper-right true diagonal RMS 0.361324723 remain failures.",
      "sources": [
