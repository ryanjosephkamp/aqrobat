    },
    {
      "id": "C9",
      "kind": "measured",
      "statement": "D1 square passes the strict gate and all three readers; both rounded treatments and circle fail strict gate while ZXing/jsQR recover exactly. OpenCV returns empty for those three.",
      "sources": [
        {
          "path": "docs/research/prose-qr/control-panel-2026-10-10/comparison.json",
          "keys": [
            "rows[*].id",
            "rows[*].readers[*].texts",
