          "sha256": "92993b7fd4c36a3f3ed75ec6f978ca2756f5836e6bfab34c55137bc485ea8923"
        }
      ],
      "limit": "Conventional image evidence is separate from native eligibility, standards compliance and scanning acceptance."
    },
    {
      "id": "C10",
      "kind": "measured",
      "statement": "Context-03 painted zero dark pixels in its initial probes; context-04 records 632/631/632 and explicit stroke 4. Context-04 ordinary reader slots are all empty.",
      "sources": [
        {
          "path": "docs/research/prose-qr/astra-2026-10-10/initial-paint-check.json",
          "keys": [
            "rows[*].phase",
            "rows[*].probes[*].grayBelow128Pixels",
